[Unit]
Description=Jetson Xavier NX fan temperature controller (DSBOX-NX2 digital-output fan)
After=jtop.service network-online.target
Requires=jtop.service

[Service]
Type=simple
# The sysfs GPIO driver needs root; the I2C expander driver only needs
# access to /dev/i2c-8.
User=root
WorkingDirectory=/opt/jetson-fan-control
ExecStart=/opt/jetson-fan-control/.venv/bin/python -m jetson_fan_control
Restart=always
RestartSec=5

# Settings (FAN_CONTROL_* variables, see the README) live in this file so
# they survive reinstalls; install.sh writes it. Anything not set there
# falls back to the defaults in jetson_fan_control/config.py.
EnvironmentFile=-/etc/default/jetson-fan-control

[Install]
# Started alongside jtop.service rather than by multi-user.target:
# jtop.service is ordered After=multi-user.target, so a unit that is both
# wanted by multi-user.target and ordered after jtop.service forms an
# ordering cycle, and systemd drops it from the boot.
WantedBy=jtop.service
